APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Origin of the Vite SPA. Used to build links the backend emails to users
# (password reset today, notification deep-links next). Distinct from APP_URL,
# which is this API.
FRONTEND_URL=http://localhost:5173


MARKETPLACE_DEFAULT_CURRENCY=INR
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================================================
# AI layer (Phases 11-15)
#
# Development needs NO paid API key. Leave AI_PROVIDER=ollama, run Ollama
# locally, and every AI feature works — with marketplace data never leaving
# the machine.
#
# With AI_ENABLED=false the marketplace behaves exactly as it did before the
# AI layer existed. Nothing breaks.
# ==========================================================================
AI_ENABLED=true
AI_PROVIDER=ollama

# Ollama (development default). Pull the model first: `ollama pull llama3.1`
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.1
AI_EMBEDDING_MODEL=nomic-embed-text
# Local CPU inference is slow; this is not a hosted-API timeout.
AI_TIMEOUT=120

# Optional cheaper/stronger models per task tier. Unset = use AI_MODEL for all.
# AI_MODEL_FAST=
# AI_MODEL_STRONG=

# Hosted providers. Set AI_PROVIDER to openai | gemini | claude and supply a key.
# AI_BASE_URL also lets the openai driver target any OpenAI-compatible gateway.
# NEVER commit a real key.
# AI_API_KEY=
# AI_ANTHROPIC_VERSION=2023-06-01

# Cost estimation, per 1000 tokens, in your billing currency. Default 0, which is
# truthful for local Ollama. Set these from your provider's own pricing page —
# no commercial pricing is hardcoded in the app.
# AI_COST_PROMPT=0
# AI_COST_COMPLETION=0

# Feature flags. Each can be disabled on its own without affecting the others
# or the marketplace.
AI_FEATURE_ASSISTANT=true
AI_FEATURE_REQUIREMENT_BUILDER=true
AI_FEATURE_SEARCH=true
AI_FEATURE_MATCHING=true
AI_FEATURE_QUOTE_COMPARISON=true
AI_FEATURE_LISTING_GENERATOR=true
AI_FEATURE_RESPONSE_ASSISTANT=true
AI_FEATURE_ADMIN_COPILOT=true
AI_FEATURE_DEMAND_INSIGHTS=true
# Off: semantic search needs an embedding store these phases do not build.
AI_FEATURE_SEMANTIC_SEARCH=false

# Abuse and cost limits. Daily quota is counted from the ai_requests table, so it
# survives a cache flush or a restart. The per-minute limit is a separate burst brake.
AI_MAX_REQUESTS_PER_DAY_CUSTOMER=100
AI_MAX_REQUESTS_PER_DAY_OWNER=200
AI_MAX_REQUESTS_PER_DAY_ADMIN=500
AI_RATE_LIMIT_PER_MINUTE=12
AI_MAX_TOOL_CALLS_PER_TURN=5
AI_CONTEXT_MESSAGES=12
AI_MAX_INPUT_CHARACTERS=4000
AI_ACTION_TTL_MINUTES=30

# Generation defaults. Low temperature on purpose: this assistant reports facts
# retrieved from the database, so variance is a bug rather than a feature.
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1200
AI_AVAILABILITY_CACHE_SECONDS=30
